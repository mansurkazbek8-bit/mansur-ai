# Mansur AI — настройки для сервера в интернете.
# Скрипт setup.sh копирует этот файл в server/.env и сам подставляет домен, ключ и пароли.
APP_NAME="Mansur AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://DOMAIN
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mansur_ai
DB_USERNAME=mansur
DB_PASSWORD=DB_PASSWORD_HERE

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Почту удобнее настроить в Админ-панели → Почта (Gmail: smtp.gmail.com, порт 587, пароль приложения)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# Нейросети: ключи удобнее вводить в Админ-панели → Провайдеры
POLLINATIONS_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
AI_MODERATION=true

# Оплата агентов: demo — покупка подтверждается сразу (учебный режим), off — покупка отключена
AGENT_PAYMENT_MODE=demo

# Администратор, которого создаст сидер на новом сервере (если база переносится — не используется)
ADMIN_EMAIL=admin@mansur.ai
ADMIN_PASSWORD=ADMIN_PASSWORD_HERE
